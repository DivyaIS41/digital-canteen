# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Database Configuration
DB_USER=root
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_NAME=canteen
DB_PORT=3306

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use_a_strong_admin_password_here
WALLET_PIN=replace_with_a_private_wallet_pin

# Flask Configuration
FLASK_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars
FLASK_ENV=development
FLASK_DEBUG=False
SESSION_COOKIE_SECURE=False
SESSION_LIFETIME_SECONDS=7200
PORT=5000
ADMIN_PORT=5001
